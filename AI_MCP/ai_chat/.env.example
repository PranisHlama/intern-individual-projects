# Odoo AI Chat Module Configuration
# Copy to .env and fill in values

# MCP Server Authentication (must match harness MCP_INTERNAL_KEY)
AI_CHAT_MCP_KEY=your-mcp-internal-key

# Harness Backend URL (where Odoo proxies chat requests)
AI_CHAT_BACKEND_URL=http://host.docker.internal:8080

# Harness API Key (for Odoo -> Harness auth)
AI_CHAT_API_KEY=your-harness-api-key

# Knowledge Base Root Path (for search_knowledge tool)
AI_KNOWLEDGE_ROOT=/mnt/ai_chat_knowledge