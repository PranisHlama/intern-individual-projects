# Server Configuration
PORT=8080
NODE_ENV=development

# Odoo MCP Server Configuration
MCP_URL=http://localhost:8069/ai_chat/mcp
MCP_INTERNAL_KEY=your-mcp-internal-key-here
MCP_TOOLS_CACHE_TTL_MS=300000

# LLM Provider Configuration - Optimized Provider-Based Format
# Single provider config + multiple models sharing endpoint/apiKey
MODELS_CONFIG='{
  "providers": [
    {
      "id": "nvidia",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "apiKey": "your-nvidia-api-key-here",
      "defaultCapabilities": { "streaming": true, "tools": true, "contextWindow": 4096 },
      "defaultMaxTokens": 100000,
      "defaultTemperature": 0.7,
      "defaultTimeoutMs": 45000
    },
    {
      "id": "gemini",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "apiKey": "your-gemini-api-key-here",
      "defaultCapabilities": { "streaming": true, "tools": true, "contextWindow": 1000000 },
      "defaultMaxTokens": 100000,
      "defaultTemperature": 0.7,
      "defaultTimeoutMs": 45000
    }
  ],
  "models": [
    {
      "providerId": "nvidia",
      "modelId": "nvidia/nemotron-3-ultra-550b-a55b",
      "displayName": "Nemotron 3 Ultra 550B",
      "capabilities": { "streaming": true, "tools": true, "contextWindow": 4096 },
      "isDefault": true
    },
    {
      "providerId": "gemini",
      "modelId": "gemini-1.5-flash",
      "displayName": "Gemini 1.5 Flash",
      "capabilities": { "streaming": true, "tools": true, "contextWindow": 1000000 },
      "isDefault": false
    },
    {
      "providerId": "gemini",
      "modelId": "gemini-1.5-pro",
      "displayName": "Gemini 1.5 Pro",
      "capabilities": { "streaming": true, "tools": true, "contextWindow": 2000000 },
      "isDefault": false
    }
  ]
}'

# Legacy single-model configuration (fallback if MODELS_CONFIG not set)
# LLM_API_KEY=your-llm-api-key-here
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_MAX_TOKENS=100000
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_MS=45000

# MCP Call Timeout
MCP_CALL_TIMEOUT_MS=30000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Conversation Storage
CONVERSATION_TTL_HOURS=48
CONVERSATION_MAX_MESSAGES=50000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0
REDIS_CONNECTION_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=3

# Context Window Configuration
CONTEXT_WINDOW_SIZE=100
MAX_CONTEXT_TOKENS=1000000