# Server Configuration
PORT=8080
NODE_ENV=development

# Odoo MCP Server Configuration
MCP_URL=http://localhost:8069/ai_chat/mcp
MCP_INTERNAL_KEY=your-mcp-internal-key-here
MCP_TOOLS_CACHE_TTL_MS=300000
MCP_CALL_TIMEOUT_MS=30000

# LLM Provider Configuration - MODELS_CONFIG is the SINGLE SOURCE OF TRUTH
# Each model explicitly defines ALL its settings (no fallbacks)
MODELS_CONFIG='{
  "providers": [
    {
      "id": "nvidia",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "apiKey": "your-nvidia-api-key-here"
    },
    {
      "id": "gemini",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "apiKey": "your-gemini-api-key-here"
    }
  ],
  "models": [
    {
      "providerId": "nvidia",
      "modelId": "nvidia/nemotron-3-ultra-550b-a55b",
      "displayName": "Nemotron 3 Ultra 550B",
      "capabilities": { "streaming": true, "tools": true, "contextWindow": 4096 },
      "maxTokens": 100000,
      "temperature": 0.7,
      "timeoutMs": 45000,
      "isDefault": true
    },
    {
      "providerId": "gemini",
      "modelId": "gemini-1.5-flash",
      "displayName": "Gemini 1.5 Flash",
      "capabilities": { "streaming": true, "tools": true, "contextWindow": 1000000 },
      "maxTokens": 100000,
      "temperature": 0.7,
      "timeoutMs": 45000,
      "isDefault": false
    },
    {
      "providerId": "gemini",
      "modelId": "gemini-1.5-pro",
      "displayName": "Gemini 1.5 Pro",
      "capabilities": { "streaming": true, "tools": true, "contextWindow": 2000000 },
      "maxTokens": 100000,
      "temperature": 0.7,
      "timeoutMs": 45000,
      "isDefault": false
    }
  ]
}'

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Conversation Storage
CONVERSATION_TTL_HOURS=48
CONVERSATION_MAX_MESSAGES=50000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0
REDIS_CONNECTION_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=3

# Fallback only - used when model not found in registry
MAX_CONTEXT_TOKENS=1000000
