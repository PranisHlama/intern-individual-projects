{
  "name": "cafe-ai-harness",
  "version": "1.0.0",
  "description": "AI Chat Harness for Odoo - Hexagonal Architecture",
  "main": "dist/container/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file=.env src/container/main.ts",
    "start": "node dist/adapters/primary/express/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src tests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "chat",
    "mcp",
    "odoo",
    "hexagonal"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "redis": "^6.3.0",
    "tiktoken": "^1.0.22",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}