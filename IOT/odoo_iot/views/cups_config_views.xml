<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- CUPS Printer List -->

    <record id="cups_config_view_list" model="ir.ui.view">
        <field name="name">cups.config.list</field>
        <field name="model">cups.config</field>
        <field name="arch" type="xml">
            <list string="CUPS Printers">
                <field name="name"/>
                <field name="server_host"/>
                <field name="server_port"/>
                <field name="printer_name"/>
                <field name="is_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- CUPS Printer Form -->

    <record id="cups_config_view_form" model="ir.ui.view">
        <field name="name">cups.config.form</field>
        <field name="model">cups.config</field>
        <field name="arch" type="xml">
            <form string="CUPS Printer Configuration">

                <header>
                    <button
                        name="action_test_connection"
                        type="object"
                        string="Test Connection"
                        class="btn-secondary"
                    />

                    <button
                        name="action_open_print_wizard"
                        type="object"
                        string="Print PDF"
                        class="btn-primary"
                    />
                </header>

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group string="CUPS Server">
                            <field name="server_host"/>
                            <field name="server_port"/>
                        </group>

                        <group string="Printer Details">
                            <field name="printer_name"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>

                    </group>

                    <group>
                        <field name="notes"/>
                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- CUPS Configuration Action -->

    <record id="cups_config_action" model="ir.actions.act_window">
        <field name="name">CUPS Printers</field>
        <field name="res_model">cups.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>