<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cups_print_wizard_view_form" model="ir.ui.view">

        <field name="name">cups.print.wizard.form</field>

        <field name="model">cups.print.wizard</field>

        <field name="arch" type="xml">

            <form string="Print PDF through CUPS">

                <group>

                    <field
                        name="report_id"
                        domain="[('report_type', '=', 'qweb-pdf')]"
                        options="{'no_create': True}"
                    />

                    <field name="printer_id"/>

                    <field
                        name="record_ids"
                        placeholder="Example: 12,13,14"
                    />

                    <field name="copies"/>

                    <field name="job_title"/>

                </group>

                <footer>

                    <button
                        name="action_print"
                        type="object"
                        string="Send to Printer"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>

    </record>

</odoo>
