<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_appraisal_plan_generator" model="ir.cron">
            <field name="name">Appraisals: Generate Scheduled Recurring Appraisals</field>
            <field name="model_id" ref="model_hr_appraisal_plan"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_recurring_appraisals()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_appraisal_reminders" model="ir.cron">
            <field name="name">Appraisals: Process Pending Deadline Reminders</field>
            <field name="model_id" ref="model_hr_appraisal"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_deadline_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_appraisal_escalation" model="ir.cron">
            <field name="name">Appraisals: Escalate Overdue Evaluations</field>
            <field name="model_id" ref="model_hr_appraisal"/>
            <field name="state">code</field>
            <field name="code">model.cron_escalate_overdue_appraisals()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_appraisal_auto_archive" model="ir.cron">
            <field name="name">Appraisals: Auto-Archive Historical Appraisals</field>
            <field name="model_id" ref="model_hr_appraisal"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_archive_completed()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
