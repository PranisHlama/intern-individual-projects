<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_hr_appraisal" model="ir.actions.report">
        <field name="name">Performance Appraisal Summary</field>
        <field name="model">hr.appraisal</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_appraisal_pro.report_appraisal_summary_document</field>
        <field name="print_report_name">'Appraisal_%s_%s' % (object.employee_id.name.replace(' ', '_'), object.review_period.replace(' ', '_'))</field>
        <field name="binding_model_id" ref="model_hr_appraisal"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
