<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_appraisal_summary_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #1e293b;">

                        <div style="border-bottom: 2px solid #0f172a; padding-bottom: 12px; margin-bottom: 20px;">
                            <div class="row align-items-center">
                                <div class="col-8">
                                    <h2 style="font-weight: 700; color: #0f172a; margin-bottom: 4px;">Performance Appraisal Summary</h2>
                                    <h4 style="color: #475569; font-weight: 500; margin: 0;"><t t-out="o.employee_id.name"/> — <t t-out="o.job_id.name or 'Team Member'"/></h4>
                                </div>
                                <div class="col-4 text-end">
                                    <div style="background-color: #f1f5f9; border-radius: 8px; padding: 10px 14px; display: inline-block; border: 1px solid #cbd5e1;">
                                        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block;">Overall Rating</span>
                                        <span style="font-size: 22px; font-weight: 700; color: #059669;"><t t-out="o.final_score"/> / 5.0</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card mb-4" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px;">
                            <div class="card-body p-3">
                                <div class="row">
                                    <div class="col-6">
                                        <p class="mb-1"><strong>Reference:</strong> <t t-out="o.name"/></p>
                                        <p class="mb-1"><strong>Department:</strong> <t t-out="o.department_id.name or 'N/A'"/></p>
                                        <p class="mb-1"><strong>Reviewing Manager:</strong> <t t-out="o.manager_id.name or 'N/A'"/></p>
                                        <p class="mb-0"><strong>HR Responsible:</strong> <t t-out="o.hr_responsible_id.name or 'HR Team'"/></p>
                                    </div>
                                    <div class="col-6">
                                        <p class="mb-1"><strong>Review Period:</strong> <t t-out="o.review_period"/></p>
                                        <p class="mb-1"><strong>Cycle Period:</strong> <t t-out="o.date_start"/> to <t t-out="o.date_close"/></p>
                                        <p class="mb-1"><strong>Status:</strong> <span class="badge text-bg-primary"><t t-out="o.stage_id.name"/></span></p>
                                        <p class="mb-0"><strong>Final Sign-off Date:</strong> <t t-out="o.date_completed or 'In Progress'"/></p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h4 style="color: #0f172a; font-weight: 600; border-bottom: 1px solid #cbd5e1; padding-bottom: 6px;">1. Competency &amp; Behavioral Assessment</h4>
                            <table class="table table-sm table-striped mt-2" style="font-size: 12px;">
                                <thead style="background-color: #0f172a; color: #ffffff;">
                                    <tr>
                                        <th>Category</th>
                                        <th>Competency</th>
                                        <th class="text-center">Weight</th>
                                        <th class="text-center">Self</th>
                                        <th class="text-center">Manager</th>
                                        <th class="text-center">Final Score</th>
                                        <th>Comments</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.competency_line_ids" t-as="comp">
                                        <td><t t-out="comp.category_id.name"/></td>
                                        <td><strong><t t-out="comp.competency_id.name"/></strong></td>
                                        <td class="text-center"><t t-out="comp.weight"/></td>
                                        <td class="text-center"><t t-out="comp.self_score or '-'"/></td>
                                        <td class="text-center"><t t-out="comp.manager_score or '-'"/></td>
                                        <td class="text-center" style="font-weight: 700; color: #0f172a;"><t t-out="comp.final_score"/></td>
                                        <td><t t-out="comp.manager_comments or ''"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="mb-4">
                            <h4 style="color: #0f172a; font-weight: 600; border-bottom: 1px solid #cbd5e1; padding-bottom: 6px;">2. Performance Goals &amp; Key Results</h4>
                            <table class="table table-sm table-bordered mt-2" style="font-size: 12px;">
                                <thead style="background-color: #334155; color: #ffffff;">
                                    <tr>
                                        <th>Objective / Key Result</th>
                                        <th>Target Deadline</th>
                                        <th class="text-center">Weight</th>
                                        <th class="text-center">Progress (%)</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-center">Approval</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.goal_ids" t-as="goal">
                                        <td><strong><t t-out="goal.name"/></strong></td>
                                        <td><t t-out="goal.due_date"/></td>
                                        <td class="text-center"><t t-out="goal.weight"/>%</td>
                                        <td class="text-center"><t t-out="goal.progress"/>%</td>
                                        <td class="text-center"><t t-out="goal.status"/></td>
                                        <td class="text-center"><t t-out="goal.manager_approval"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="mb-4">
                            <h4 style="color: #0f172a; font-weight: 600; border-bottom: 1px solid #cbd5e1; padding-bottom: 6px;">3. Qualitative Evaluations &amp; Growth Pathways</h4>
                            <div class="row mt-2">
                                <div class="col-6">
                                    <div class="p-3 bg-light border rounded mb-2">
                                        <strong style="color: #1e293b;">Employee Strengths &amp; Highlights:</strong>
                                        <p class="mt-1 mb-0" style="white-space: pre-line;"><t t-out="o.manager_strengths or o.self_strengths or 'None recorded.'"/></p>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-3 bg-light border rounded mb-2">
                                        <strong style="color: #1e293b;">Areas for Development:</strong>
                                        <p class="mt-1 mb-0" style="white-space: pre-line;"><t t-out="o.manager_weaknesses or o.self_development_areas or 'None recorded.'"/></p>
                                    </div>
                                </div>
                            </div>
                            <div class="p-3 bg-light border rounded mt-2">
                                <strong style="color: #1e293b;">Manager Overall Summary:</strong>
                                <p class="mt-1 mb-0" style="white-space: pre-line;"><t t-out="o.manager_overall_summary or 'No summary notes entered.'"/></p>
                            </div>
                        </div>

                        <div class="mt-5 pt-4" style="page-break-inside: avoid; border-top: 1px dashed #94a3b8;">
                            <div class="row text-center">
                                <div class="col-4">
                                    <div style="border-top: 1px solid #334155; margin: 40px 15px 0 15px; padding-top: 6px;">
                                        <strong><t t-out="o.employee_id.name"/></strong><br/>
                                        <span class="text-muted" style="font-size: 11px;">Employee Signature &amp; Date</span>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div style="border-top: 1px solid #334155; margin: 40px 15px 0 15px; padding-top: 6px;">
                                        <strong><t t-out="o.manager_id.name or 'Manager'"/></strong><br/>
                                        <span class="text-muted" style="font-size: 11px;">Reviewer Signature &amp; Date</span>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div style="border-top: 1px solid #334155; margin: 40px 15px 0 15px; padding-top: 6px;">
                                        <strong><t t-out="o.hr_responsible_id.name or 'HR Representative'"/></strong><br/>
                                        <span class="text-muted" style="font-size: 11px;">HR Officer Signature &amp; Date</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
