<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_appraisals">
        <field name="name">Appraisals Pro</field>
        <field name="sequence">16</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_appraisal_user" model="res.groups">
        <field name="name">User (Employee)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_appraisals"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Employees can view their own appraisals, fill self-assessments, and manage personal goals.</field>
    </record>

    <record id="group_appraisal_manager" model="res.groups">
        <field name="name">Manager (Reviewer)</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_appraisals"/>
        <field name="implied_ids" eval="[(4, ref('group_appraisal_user'))]"/>
        <field name="comment">Department and team managers can conduct subordinate evaluations, rate competencies, and approve goals.</field>
    </record>

    <record id="group_appraisal_officer" model="res.groups">
        <field name="name">Officer (HR Specialist)</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_appraisals"/>
        <field name="implied_ids" eval="[(4, ref('group_appraisal_manager')), (4, ref('hr.group_hr_user'))]"/>
        <field name="comment">HR Officers can create appraisal cycles, launch plans, manage templates, and execute validation.</field>
    </record>

    <record id="group_appraisal_manager_hr" model="res.groups">
        <field name="name">Administrator (HR Manager)</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_appraisals"/>
        <field name="implied_ids" eval="[(4, ref('group_appraisal_officer')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full administrative privileges, confidential notes access, score override, audit logs, and settings configuration.</field>
    </record>
</odoo>
