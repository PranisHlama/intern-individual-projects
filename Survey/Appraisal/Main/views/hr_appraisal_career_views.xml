<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_appraisal_career_plan_form" model="ir.ui.view">
        <field name="name">hr.appraisal.career.plan.form</field>
        <field name="model">hr.appraisal.career.plan</field>
        <field name="arch" type="xml">
            <form string="Career Development Plan">
                <header>
                    <button name="action_submit_for_approval" string="Submit to Manager" type="object" class="oe_highlight"
                            invisible="manager_approval != 'draft'"/>
                    <button name="action_approve" string="Endorse Plan" type="object" class="oe_highlight"
                            invisible="manager_approval not in ['pending', 'draft']"/>
                    <button name="action_mark_achieved" string="Mark Achieved" type="object" class="btn-success"
                            invisible="state == 'achieved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,achieved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Plan Title"/>
                        <h1><field name="name" placeholder="e.g. Progression to Principal Architect"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="manager_id"/>
                            <field name="appraisal_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="timeline"/>
                            <field name="manager_approval" widget="badge"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Aspirations &amp; Objective" name="objective">
                            <field name="career_objective" placeholder="Target roles, responsibilities, and long-term milestones..."/>
                        </page>
                        <page string="Required Competencies" name="skills">
                            <field name="required_skills" placeholder="Skills, tools, and experiences necessary to advance..."/>
                        </page>
                        <page string="Training &amp; Courses" name="training">
                            <field name="suggested_training" placeholder="Recommended internal/external training, certifications, and mentorship..."/>
                        </page>
                        <page string="Manager Endorsement" name="manager_notes">
                            <field name="manager_notes" placeholder="Manager coaching notes and organizational commitment..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_appraisal_career_plan_tree" model="ir.ui.view">
        <field name="name">hr.appraisal.career.plan.list</field>
        <field name="model">hr.appraisal.career.plan</field>
        <field name="arch" type="xml">
            <list string="Career Development Plans">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="timeline"/>
                <field name="progress" widget="progressbar"/>
                <field name="manager_approval" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_hr_appraisal_career_plan" model="ir.actions.act_window">
        <field name="name">Career Development Plans</field>
        <field name="res_model">hr.appraisal.career.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
