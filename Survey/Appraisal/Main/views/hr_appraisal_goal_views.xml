<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_appraisal_goal_form" model="ir.ui.view">
        <field name="name">hr.appraisal.goal.form</field>
        <field name="model">hr.appraisal.goal</field>
        <field name="arch" type="xml">
            <form string="Goals">
                <header>
                    <button name="action_mark_done" string="Mark as Done" type="object" class="oe_highlight btn-primary"
                            invisible="status == 'completed'"/>
                    <button name="action_save_as_template" string="Save as Template" type="object" class="btn-secondary"/>
                    <field name="status" widget="statusbar" statusbar_visible="not_started,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Goal Title"/>
                        <h1 class="d-flex">
                            <field name="name" placeholder="e.g. Master Espresso Calibration" class="o_goal_title_input"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" string="Employee" placeholder="Select Employee..."/>
                            <field name="appraisal_id" string="Associated Appraisal" domain="[('employee_id', '=', employee_id)]"
                                   placeholder="Select or auto-linked appraisal..."/>
                            <field name="template_id" string="Goal Template" placeholder="Select from library..."/>
                            <field name="progression" string="Milestone" widget="radio" options="{'horizontal': true}" class="o_goal_progress_radio"/>
                            <field name="progress" string="Progress" widget="progressbar"/>
                        </group>
                        <group>
                            <field name="manager_id" string="Manager"/>
                            <field name="due_date" string="Deadline"/>
                            <field name="weight" string="Weight (%)"/>
                            <field name="tag_ids" string="Tags" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="o_goal_description_section mt-3">
                        <separator string="Description / Key Results"/>
                        <field name="description" placeholder="Provide visible information on the goal, how the employee can achieve it, key results, and measurable milestones..."/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_appraisal_goal_tree" model="ir.ui.view">
        <field name="name">hr.appraisal.goal.list</field>
        <field name="model">hr.appraisal.goal</field>
        <field name="arch" type="xml">
            <list string="Goals">
                <header>
                    <button name="%(hr_appraisal_pro.action_hr_appraisal_goal_template_modal)d" string="Open Library" type="action" class="btn btn-secondary"/>
                </header>
                <field name="name" string="Goal Name"/>
                <field name="employee_id" string="Employee"/>
                <field name="appraisal_id" string="Appraisal" optional="show"/>
                <field name="weight" string="Weight (%)" optional="show"/>
                <field name="progress" string="Progress" widget="progressbar" avg="Average Progress"/>
                <field name="status" string="Status" widget="badge"
                       decoration-success="status == 'completed'"
                       decoration-info="status == 'in_progress'"
                       decoration-warning="status == 'blocked'"
                       decoration-muted="status == 'not_started'"/>
                <field name="due_date" string="Deadline"/>
                <field name="manager_approval" string="Validation" widget="badge" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hr_appraisal_goal_kanban" model="ir.ui.view">
        <field name="name">hr.appraisal.goal.kanban</field>
        <field name="model">hr.appraisal.goal</field>
        <field name="arch" type="xml">
            <kanban default_group_by="employee_id" class="o_kanban_small_column">
                <header>
                    <button name="%(hr_appraisal_pro.action_hr_appraisal_goal_template_modal)d" string="Open Library" type="action" class="btn btn-secondary"/>
                </header>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="appraisal_id"/>
                <field name="due_date"/>
                <field name="progress"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                        </div>
                        <div class="o_kanban_record_body my-2">
                            <div><field name="employee_id"/></div>
                            <t t-if="record.appraisal_id.raw_value">
                                <small class="text-muted"><i class="fa fa-certificate me-1" title="Appraisal"/> <field name="appraisal_id"/></small>
                            </t>
                            <div class="mt-2">
                                <field name="progress" widget="progressbar"/>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <span class="text-muted"><i class="fa fa-calendar me-1" title="Deadline" role="img" aria-label="Deadline"/> <field name="due_date"/></span>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="status" widget="badge"
                                       decoration-success="status == 'completed'"
                                       decoration-info="status == 'in_progress'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hr_appraisal_goal_graph" model="ir.ui.view">
        <field name="name">hr.appraisal.goal.graph</field>
        <field name="model">hr.appraisal.goal</field>
        <field name="arch" type="xml">
            <graph string="Goals by Employee" type="bar">
                <field name="employee_id"/>
                <field name="progress" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_hr_appraisal_goal_search" model="ir.ui.view">
        <field name="name">hr.appraisal.goal.search</field>
        <field name="model">hr.appraisal.goal</field>
        <field name="arch" type="xml">
            <search string="Search Goals">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="appraisal_id"/>
                <field name="template_id"/>
                <field name="tag_ids"/>
                <filter string="My Goals" name="my_goals" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="My Team's Goals" name="team_goals" domain="[('manager_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="In Ongoing Appraisal" name="in_appraisal" domain="[('appraisal_id', '!=', False)]"/>
                <filter string="Standalone Goals" name="standalone" domain="[('appraisal_id', '=', False)]"/>
                <separator/>
                <filter string="Active" name="active_goals" domain="[('status', 'in', ['not_started', 'in_progress', 'blocked'])]"/>
                <filter string="Completed" name="completed_goals" domain="[('status', '=', 'completed')]"/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Appraisal" name="group_appraisal" context="{'group_by': 'appraisal_id'}"/>
                    <filter string="Deadline Month" name="group_due_date" context="{'group_by': 'due_date:month'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_appraisal_goal" model="ir.actions.act_window">
        <field name="name">Goals</field>
        <field name="res_model">hr.appraisal.goal</field>
        <field name="view_mode">list,kanban,graph,form</field>
        <field name="search_view_id" ref="view_hr_appraisal_goal_search"/>
        <field name="context">{'search_default_group_employee': 1}</field>
        <field name="help" type="html">
            <div class="o_view_nocontent">
                <div class="o_nocontent_help">
                    <p class="o_view_nocontent_smiling_face">
                        Create new goals
                    </p>
                    <p>
                        Assign Goals to motivate your Employees and keep track of their objectives between Appraisals.
                    </p>
                </div>
            </div>
        </field>
    </record>
</odoo>
