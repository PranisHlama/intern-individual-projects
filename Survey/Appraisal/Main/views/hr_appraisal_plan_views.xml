<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_appraisal_plan_form" model="ir.ui.view">
        <field name="name">hr.appraisal.plan.form</field>
        <field name="model">hr.appraisal.plan</field>
        <field name="arch" type="xml">
            <form string="Appraisal Plan">
                <header>
                    <button name="action_generate_appraisals" string="Generate Appraisals" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="task" type="action" name="%(action_hr_appraisal_all)d"
                                context="{'search_default_plan_id': id}">
                            <field name="appraisal_count" widget="statinfo" string="Appraisals"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Plan Title"/>
                        <h1><field name="name" placeholder="e.g. 2026 Annual Performance Cycle"/></h1>
                    </div>
                    <group>
                        <group string="Schedule &amp; Frequency">
                            <field name="frequency"/>
                            <field name="custom_interval_days" invisible="frequency != 'custom'"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="lead_days"/>
                            <field name="duration_days"/>
                            <field name="next_generation_date"/>
                            <field name="last_generation_date" readonly="1"/>
                        </group>
                        <group string="Governance &amp; Configuration">
                            <field name="hr_responsible_id"/>
                            <field name="template_id"/>
                            <field name="rating_scale_id"/>
                            <field name="self_assessment_required"/>
                            <field name="manager_required"/>
                            <field name="final_approval_required"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Target Population Filters" name="filters">
                            <group>
                                <field name="department_ids" widget="many2many_tags" placeholder="All Departments if empty"/>
                                <field name="job_ids" widget="many2many_tags" placeholder="All Job Roles if empty"/>
                                <field name="category_ids" widget="many2many_tags" placeholder="Filter by Employee Tags"/>
                                <field name="employee_ids" widget="many2many_tags" placeholder="Specific Employees (overrides above filters)"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_appraisal_plan_tree" model="ir.ui.view">
        <field name="name">hr.appraisal.plan.list</field>
        <field name="model">hr.appraisal.plan</field>
        <field name="arch" type="xml">
            <list string="Appraisal Plans">
                <field name="name"/>
                <field name="frequency"/>
                <field name="next_generation_date"/>
                <field name="hr_responsible_id"/>
                <field name="appraisal_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_hr_appraisal_plan" model="ir.actions.act_window">
        <field name="name">Appraisal Plans</field>
        <field name="res_model">hr.appraisal.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
