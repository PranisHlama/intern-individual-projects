<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_appraisal_survey_form" model="ir.ui.view">
        <field name="name">hr.appraisal.survey.form</field>
        <field name="model">hr.appraisal.survey</field>
        <field name="arch" type="xml">
            <form string="Appraisal Survey Assessment">
                <header>
                    <button name="action_start" string="Start Assessment" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_submit" string="Submit Survey" type="object" class="btn-success"
                            invisible="state == 'submitted'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" class="btn-secondary"
                            invisible="state == 'draft'" groups="hr_appraisal_pro.group_appraisal_officer"/>
                    <button name="action_load_questions" string="Load Template Questions" type="object" class="btn-outline-secondary"
                            invisible="state == 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,submitted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="badge" type="object" name="action_open_appraisal"
                                invisible="not appraisal_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Appraisal</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Submitted" bg_color="text-bg-success" invisible="state != 'submitted'"/>

                    <div class="oe_title">
                        <div class="mb-2">
                            <field name="survey_type" widget="badge"
                                   decoration-info="survey_type == 'self'"
                                   decoration-warning="survey_type == 'peer'"
                                   decoration-primary="survey_type == 'manager'"/>
                        </div>
                        <h1 class="my-0"><field name="name"/></h1>
                    </div>

                    <group>
                        <group string="Evaluation Subject &amp; Reviewer">
                            <field name="employee_id"/>
                            <field name="respondent_id"/>
                            <field name="user_id" invisible="1"/>
                            <field name="appraisal_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Template &amp; Scoring">
                            <field name="template_id"/>
                            <field name="date_deadline"/>
                            <field name="date_completed" invisible="not date_completed"/>
                            <field name="score" widget="badge"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Survey Questions &amp; Responses" name="questions">
                            <field name="answer_ids">
                                <list editable="bottom" create="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="section_id"/>
                                    <field name="question_id" readonly="1"/>
                                    <field name="question_type" column_invisible="1"/>
                                    <field name="is_required" column_invisible="1"/>
                                    <field name="rating_answer" string="Rating (1-5)"
                                           invisible="question_type != 'rating'"/>
                                    <field name="choice_id" string="Selected Choice"
                                           invisible="question_type not in ['selection', 'multiple_choice']"/>
                                    <field name="boolean_answer" string="Yes / No"
                                           invisible="question_type != 'boolean'"/>
                                    <field name="paragraph_answer" string="Written Response"
                                           invisible="question_type not in ['text', 'paragraph', 'matrix']"
                                           placeholder="Enter response..."/>
                                    <field name="score_value" widget="badge" optional="show"/>
                                    <field name="comments" placeholder="Optional comments..." optional="hide"/>
                                </list>
                                <form string="Question Detail Response">
                                    <group>
                                        <group>
                                            <field name="section_id"/>
                                            <field name="question_id" readonly="1"/>
                                            <field name="help_text" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="question_type" readonly="1"/>
                                            <field name="rating_answer" invisible="question_type != 'rating'"/>
                                            <field name="choice_id" invisible="question_type not in ['selection', 'multiple_choice']"/>
                                            <field name="boolean_answer" invisible="question_type != 'boolean'"/>
                                            <field name="score_value"/>
                                        </group>
                                    </group>
                                    <field name="paragraph_answer" placeholder="Detailed response..."/>
                                    <field name="comments" placeholder="Additional reviewer comments..."/>
                                </form>
                            </field>
                        </page>
                        <page string="Overall Qualitative Review &amp; Recommendations" name="summary_tab">
                            <field name="summary" placeholder="Provide general feedback, overall achievements, strengths, development areas, or notes for this appraisal cycle..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_appraisal_survey_tree" model="ir.ui.view">
        <field name="name">hr.appraisal.survey.list</field>
        <field name="model">hr.appraisal.survey</field>
        <field name="arch" type="xml">
            <list string="Appraisal Surveys &amp; Assessments">
                <field name="name"/>
                <field name="survey_type" widget="badge"
                       decoration-info="survey_type == 'self'"
                       decoration-warning="survey_type == 'peer'"
                       decoration-primary="survey_type == 'manager'"/>
                <field name="employee_id"/>
                <field name="respondent_id"/>
                <field name="template_id"/>
                <field name="date_deadline"/>
                <field name="score" widget="badge"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'submitted'"
                       decoration-info="state == 'in_progress'"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_appraisal_survey_kanban" model="ir.ui.view">
        <field name="name">hr.appraisal.survey.kanban</field>
        <field name="model">hr.appraisal.survey</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="survey_type"/>
                <field name="employee_id"/>
                <field name="respondent_id"/>
                <field name="state"/>
                <field name="score"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-light text-dark border">
                                <i class="oi oi-fw me-1" data-icon="edit_square" title="Survey Type" role="img" aria-label="Survey Type"/>
                                <field name="survey_type"/>
                            </span>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'submitted'"
                                   decoration-info="state == 'in_progress'"
                                   decoration-muted="state == 'draft'"/>
                        </div>
                        <strong class="d-block text-truncate mb-1"><field name="name"/></strong>
                        <div class="text-muted small mb-1">
                            <i class="oi oi-fw me-1" data-icon="account_circle" title="Appraised Employee" role="img" aria-label="Appraised Employee"/>
                            <span>Appraised: </span><field name="employee_id"/>
                        </div>
                        <div class="text-muted small mb-2">
                            <i class="oi oi-fw me-1" data-icon="person" title="Reviewer" role="img" aria-label="Reviewer"/>
                            <span>Reviewer: </span><field name="respondent_id"/>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">
                                <i class="oi oi-fw me-1" data-icon="calendar_today" title="Deadline" role="img" aria-label="Deadline"/>
                                <field name="date_deadline"/>
                            </span>
                            <span class="badge bg-success-subtle text-success fw-bold">
                                <i class="oi oi-fw me-1" data-icon="star" title="Score" role="img" aria-label="Score"/>
                                Score: <field name="score"/> / 5.0
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hr_appraisal_survey_search" model="ir.ui.view">
        <field name="name">hr.appraisal.survey.search</field>
        <field name="model">hr.appraisal.survey</field>
        <field name="arch" type="xml">
            <search string="Search Surveys">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="respondent_id"/>
                <field name="appraisal_id"/>
                <field name="template_id"/>
                <separator/>
                <filter string="Self Assessments" name="filter_self" domain="[('survey_type', '=', 'self')]"/>
                <filter string="Peer Assessments" name="filter_peer" domain="[('survey_type', '=', 'peer')]"/>
                <filter string="Manager Evaluations" name="filter_manager" domain="[('survey_type', '=', 'manager')]"/>
                <separator/>
                <filter string="Draft / Pending" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Submitted" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <group>
                    <filter string="Survey Type" name="group_survey_type" context="{'group_by': 'survey_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Employee Appraised" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Reviewer / Respondent" name="group_respondent" context="{'group_by': 'respondent_id'}"/>
                    <filter string="Appraisal Cycle" name="group_appraisal" context="{'group_by': 'appraisal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_appraisal_survey" model="ir.actions.act_window">
        <field name="name">Appraisal Surveys &amp; Assessments</field>
        <field name="res_model">hr.appraisal.survey</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_hr_appraisal_survey_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No surveys found!
            </p>
            <p>
                Surveys capture Self Assessments, Peer Reviews, and Manager Evaluations using defined questionnaire templates.
            </p>
        </field>
    </record>
</odoo>
