<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_appraisal_template_form" model="ir.ui.view">
        <field name="name">hr.appraisal.template.form</field>
        <field name="model">hr.appraisal.template</field>
        <field name="arch" type="xml">
            <form string="Appraisal Questionnaire Template">
                <header>
                    <button name="action_duplicate_template" string="Duplicate Template" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Template Title"/>
                        <h1><field name="name" placeholder="e.g. Annual Executive Review Questionnaire"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="target_role"/>
                            <field name="survey_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="question_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sections &amp; Questions" name="questions">
                            <field name="question_ids">
                                <list string="Questions" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="section_id"/>
                                    <field name="name"/>
                                    <field name="question_type"/>
                                    <field name="target_respondent"/>
                                    <field name="is_required"/>
                                    <field name="char_limit"/>
                                </list>
                                <form string="Question Detail">
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="section_id"/>
                                            <field name="question_type"/>
                                            <field name="target_respondent"/>
                                            <field name="is_required"/>
                                        </group>
                                        <group>
                                            <field name="sequence"/>
                                            <field name="char_limit"/>
                                            <field name="rating_min" invisible="question_type != 'rating'"/>
                                            <field name="rating_max" invisible="question_type != 'rating'"/>
                                            <field name="is_conditional"/>
                                            <field name="parent_question_id" invisible="not is_conditional"/>
                                            <field name="trigger_choice_id" invisible="not is_conditional"/>
                                        </group>
                                    </group>
                                    <field name="help_text" placeholder="Guidance or instruction for respondents..."/>
                                    <notebook invisible="question_type not in ['selection', 'multiple_choice', 'matrix']">
                                        <page string="Choice Options" name="choices" invisible="question_type not in ['selection', 'multiple_choice']">
                                            <field name="choice_ids">
                                                <list editable="bottom">
                                                    <field name="sequence" widget="handle"/>
                                                    <field name="name"/>
                                                    <field name="score_value"/>
                                                </list>
                                            </field>
                                        </page>
                                        <page string="Matrix Criteria (Rows)" name="matrix_rows" invisible="question_type != 'matrix'">
                                            <field name="matrix_row_ids">
                                                <list editable="bottom">
                                                    <field name="sequence" widget="handle"/>
                                                    <field name="name"/>
                                                </list>
                                            </field>
                                        </page>
                                        <page string="Matrix Scales (Columns)" name="matrix_cols" invisible="question_type != 'matrix'">
                                            <field name="matrix_col_ids">
                                                <list editable="bottom">
                                                    <field name="sequence" widget="handle"/>
                                                    <field name="name"/>
                                                    <field name="score_value"/>
                                                </list>
                                            </field>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                        <page string="Sections" name="sections">
                            <field name="section_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Instructions / Overview" name="instructions">
                            <field name="description" placeholder="Instructions displayed at the top of the questionnaire..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_appraisal_template_tree" model="ir.ui.view">
        <field name="name">hr.appraisal.template.list</field>
        <field name="model">hr.appraisal.template</field>
        <field name="arch" type="xml">
            <list string="Questionnaire Templates">
                <field name="name"/>
                <field name="target_role"/>
                <field name="question_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_hr_appraisal_template" model="ir.actions.act_window">
        <field name="name">Questionnaires</field>
        <field name="res_model">hr.appraisal.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
