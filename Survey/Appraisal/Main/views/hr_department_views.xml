<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_department_form_appraisal_inherit" model="ir.ui.view">
        <field name="name">hr.department.form.appraisal.inherit</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="task" type="object" name="action_open_department_appraisals">
                    <field name="appraisal_count" widget="statinfo" string="Appraisals"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
