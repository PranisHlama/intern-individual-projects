<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_appraisal_report_export_wizard_form" model="ir.ui.view">
        <field name="name">hr.appraisal.report.export.wizard.form</field>
        <field name="model">hr.appraisal.report.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Appraisals &amp; Analytics">
                <group invisible="file_data">
                    <group string="Output Format">
                        <field name="export_format" widget="radio"/>
                    </group>
                    <group string="Filter Constraints">
                        <field name="department_id"/>
                        <field name="stage_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <div invisible="not file_data" class="alert alert-success text-center" role="alert">
                    <h4>Export Ready for Download!</h4>
                    <p>Click below to download your generated report file:</p>
                    <field name="file_data" filename="file_name" widget="binary"/>
                </div>
                <footer>
                    <button name="action_export_report" string="Generate File" type="object" class="btn-primary" invisible="file_data"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_appraisal_report_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Appraisals</field>
        <field name="res_model">hr.appraisal.report.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
