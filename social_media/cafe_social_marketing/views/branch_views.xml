<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="cafe_social_branch_view_list" model="ir.ui.view">
        <field name="name">cafe.social.branch.view.list</field>
        <field name="model">cafe.social.branch</field>
        <field name="arch" type="xml">
            <list string="Cafe Branches">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="cafe_social_branch_view_form" model="ir.ui.view">
        <field name="name">cafe.social.branch.view.form</field>
        <field name="model">cafe.social.branch</field>
        <field name="arch" type="xml">
            <form string="Cafe Branch">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>

                        <group>
                            <field name="active"/>
                        </group>
                    </group>

                    <group>
                        <field name="address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cafe_social_branch_action" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">cafe.social.branch</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>