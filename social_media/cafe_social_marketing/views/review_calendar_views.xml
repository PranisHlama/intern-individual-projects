<odoo>
    <record id="cafe_social_request_changes_view_form" model="ir.ui.view">
        <field name="name">cafe.social.request.changes.form</field>
        <field name="model">cafe.social.request.changes</field>
        <field name="arch" type="xml">
            <form string="Request Changes">
                <group>
                    <field name="post_id"/>
                    <field name="reason" placeholder="Example: Mention Baneshwor branch clearly and correct the discount wording."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Send Request" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="cafe_social_review_feedback_form" model="ir.ui.view">
        <field name="name">cafe.social.post.review.feedback.form</field>
        <field name="model">cafe.social.post</field>
        <field name="inherit_id" ref="cafe_social_post_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_reject']" position="after">
                <button name="action_open_request_changes" string="Request Changes" type="object"
                        groups="cafe_social_marketing.group_cafe_social_manager"
                        invisible="state not in ['draft', 'scheduled'] or approval_state not in ['pending', 'approved']"/>
            </xpath>
            <xpath expr="//button[@name='action_submit_review']" position="attributes">
                <attribute name="invisible">state != 'draft' or validation_status != 'passed' or approval_state not in ['not_submitted', 'rejected', 'changes_requested']</attribute>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Latest Reviewer Feedback" invisible="not reviewer_comment">
                    <field name="reviewer_comment"/>
                    <field name="changes_requested_by_id"/>
                    <field name="changes_requested_at"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="cafe_social_post_calendar" model="ir.ui.view">
        <field name="name">cafe.social.post.calendar</field>
        <field name="model">cafe.social.post</field>
        <field name="arch" type="xml">
            <calendar string="Branch Content Calendar" date_start="scheduled_at"
                      color="branch_id" mode="month" create="false" edit="false"
                      delete="false" quick_create="false">
                <field name="name"/>
                <field name="branch_id" filters="1"/>
                <field name="campaign_id"/>
                <field name="state"/>
                <field name="approval_state"/>
                <field name="social_account_ids" widget="many2many_tags"/>
            </calendar>
        </field>
    </record>

    <record id="cafe_social_calendar_search" model="ir.ui.view">
        <field name="name">cafe.social.post.calendar.search</field>
        <field name="model">cafe.social.post</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="branch_id"/>
                <field name="campaign_id"/>
                <separator/>
                <filter name="scheduled" string="Scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="needs_changes" string="Changes Requested" domain="[('approval_state', '=', 'changes_requested')]"/>
                <separator/>
                <filter name="group_branch" string="Group by Branch" context="{'group_by': 'branch_id'}"/>
                <filter name="group_campaign" string="Group by Campaign" context="{'group_by': 'campaign_id'}"/>
            </search>
        </field>
    </record>

    <record id="cafe_social_calendar_action" model="ir.actions.act_window">
        <field name="name">Branch Content Calendar</field>
        <field name="res_model">cafe.social.post</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="view_id" ref="cafe_social_post_calendar"/>
        <field name="search_view_id" ref="cafe_social_calendar_search"/>
        <field name="domain">[('scheduled_at', '!=', False)]</field>
    </record>
</odoo>
