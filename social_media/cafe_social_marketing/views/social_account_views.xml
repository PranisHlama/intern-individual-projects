<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="cafe_social_account_view_list" model="ir.ui.view">
        <field name="name">cafe.social.account.view.list</field>
        <field name="model">cafe.social.account</field>
        <field name="arch" type="xml">
            <list string="Social Accounts">
                <field name="name"/>
                <field name="platform"/>
                <field name="handle"/>
                <field name="branch_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="cafe_social_account_view_form" model="ir.ui.view">
        <field name="name">cafe.social.account.view.form</field>
        <field name="model">cafe.social.account</field>
        <field name="arch" type="xml">
            <form string="Social Account">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="platform"/>
                            <field name="handle"/>
                        </group>

                        <group>
                            <field name="branch_id"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group
                        string="TikTok Integration"
                        invisible="platform != 'tiktok'"
                    >
                        <field
                            name="tiktok_access_token"
                            password="True"
                            groups="cafe_social_marketing.group_cafe_social_manager"
                            placeholder="Paste a TikTok video.upload access token for development testing"
                        />
                        <field
                            name="tiktok_open_id"
                            groups="cafe_social_marketing.group_cafe_social_manager"
                        />
                        <div class="text-muted">MVP note: token is entered manually for testing. OAuth connection can replace this in the next phase.</div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cafe_social_account_action" model="ir.actions.act_window">
        <field name="name">Social Accounts</field>
        <field name="res_model">cafe.social.account</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>